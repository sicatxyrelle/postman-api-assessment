        {
          "name": "get-users-userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst user = pm.response.json();\r\n\r\npm.test(\"Name has a valid record\", function(){\r\n    user.forEach(function(record){\r\n    pm.expect(record).to.have.property('name');\r\n    pm.expect(record.name).to.be.a('string');\r\n    pm.expect(record.name).to.have.lengthOf.at.least(1);\r\n    });\r\n});\r\n\r\npm.test(\"Email has a valid record\", function(){\r\n    user.forEach(function(record){\r\n    pm.expect(record).to.have.property('email');\r\n    pm.expect(record.email).to.be.a('string');\r\n    pm.expect(record.email).to.have.lengthOf.at.least(1);\r\n    });\r\n});\r\n\r\npm.test(\"NickName is valid if available\", function () {\r\n    user.forEach(function(record){\r\n    if (record.nickName !== undefined) {\r\n        pm.expect(record.nickName).to.be.a('string');\r\n        pm.expect(record.nickName).to.have.lengthOf.at.least(0);\r\n    } else {\r\n        pm.expect(record.nickName).to.not.have.property('nickName');\r\n    }});\r\n});\r\n\r\npm.test(\"Retrieved user equals to user id request\", function(){\r\n    user.forEach(function(record){\r\n    pm.expect(record.id).to.eql(pm.environment.get(\"userId\"));\r\n    console.log(\"id returned:\", record.id, \"request id:\", pm.environment.get(\"userId\"));\r\n    });\r\n});"
                ]
              }
            }
